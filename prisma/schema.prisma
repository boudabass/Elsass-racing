// Casse ou sortie de route. speciale_nom : copie du nom ; stage_id : spéciale d'abandon de Saison, sans clé étrangère (correction D).
model GarageIncident {
  id                    String          @id @db.Uuid
  teamId                String          @map("team_id") @db.Uuid
  vehicleId             String          @map("vehicle_id") @db.Uuid
  eventId               String?         @map("event_id") @db.Uuid
  eventEntryId          String?         @map("event_entry_id") @db.Uuid
  date                  DateTime        @db.Timestamptz(3)
  specialeNom           String?         @map("speciale_nom")
  stageId               String?         @map("stage_id") @db.Uuid
  type                  GarageTypeCasse?
  cause                String?
  reparationWorkOrderId String?         @map("reparation_work_order_id") @db.Uuid

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team                CoreTeam                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  vehicle             CoreVehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  event               CoreEvent?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventEntry          CoreEventEntry?           @relation(fields: [eventEntryId], references: [id], onDelete: SetNull)
  reparationWorkOrder GarageWorkOrder?          @relation(fields: [reparationWorkOrderId], references: [id], onDelete: SetNull)
  components          GarageIncidentComponent[]
  parts               GarageIncidentPart[]

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([vehicleId])
  @@index([eventId])
  @@index([eventEntryId])
  @@index([reparationWorkOrderId])
  @@map("garage_incident")
}

// Équipement de la team (remorque, outillage…). Pas de véhicule.
model GarageEquipment {
  id                 String                    @id @db.Uuid
  teamId             String                    @map("team_id") @db.Uuid
  nom                String
  categorie          GarageCategorieEquipement
  etat               String?
  acheteLe           DateTime?                 @map("achete_le") @db.Timestamptz(3)
  valeurCents        Int?                      @map("valeur_cents")
  devise             String                    @default("EUR")
  prochainControleLe DateTime?                 @map("prochain_controle_le") @db.Date
  emplacement        String?

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team CoreTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@map("garage_equipment")
}

// Ligne de commande. part_id est rempli à la réception, qui crée la pièce.
model GaragePurchaseLine {
  id                String        @id @db.Uuid
  teamId            String        @map("team_id") @db.Uuid
  purchaseId        String        @map("purchase_id") @db.Uuid
  partId            String?       @map("part_id") @db.Uuid
  designation       String
  reference         String?
  quantite          Int           @default(1)
  prixUnitaireCents Int           @default(0) @map("prix_unitaire_cents")
  devise            String        @default("EUR")
  componentTypeId   String?       @map("component_type_id") @db.Uuid
  qualite           GarageQualitePiece @default(origine)

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team          CoreTeam            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  purchase      GaragePurchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  part          GaragePart?         @relation("PieceAchetee", fields: [partId], references: [id], onDelete: SetNull)
  componentType GarageComponentType? @relation(fields: [componentTypeId], references: [id], onDelete: Restrict)
  // Pièces créées à la réception de cette ligne (une par unité).
  piecesCreees  GaragePart[]        @relation("PieceCommandee")

  @@index([teamId])
  @@index([purchaseId])
  @@index([partId])
  @@index([componentTypeId])
  @@map("garage_purchase_line")
}

// Pièces utilisées par un ordre de travail.
model GarageWorkOrderPart {
  id          String @id @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  partId      String @map("part_id") @db.Uuid

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team      CoreTeam        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  workOrder GarageWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  part      GaragePart      @relation(fields: [partId], references: [id], onDelete: Restrict)

