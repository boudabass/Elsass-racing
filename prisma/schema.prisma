// Convention avec un partenaire. Les dates de début et de fin sont des jours (Europe/Paris).
// `precedente` renseigné = renouvellement. Les montants sont en centimes.
model PartenairesAgreement {
  id                         String                     @id @db.Uuid
  teamId                     String                     @map("team_id") @db.Uuid
  partnerId                  String                     @map("partner_id") @db.Uuid
  templateId                 String?                    @map("template_id") @db.Uuid
  seasonId                   String?                    @map("season_id") @db.Uuid
  dateDebut                  DateTime                   @map("date_debut") @db.Date
  dateFin                    DateTime                   @map("date_fin") @db.Date
