enum BudgetTypePayeur {
  membre
  caisse_team
  compte_association

  @@map("budget_type_payeur")
}

enum BudgetMoyen {
  carte
  especes
  cheque
  virement

  @@map("budget_moyen")
}

enum BudgetRemboursement {
  non_concerne
  a_rembourser
  partiel
  rembourse

  @@map("budget_remboursement")
}

enum BudgetOrigine {
  saisie
  proposee

  @@map("budget_origine")
}

enum BudgetStatutRecette {
  prevue
  encaissee

  @@map("budget_statut_recette")
}

enum BudgetStatutSuggestion {
  en_attente
  confirmee
  ignoree

  @@map("budget_statut_suggestion")
}

model BudgetCategory {
  id       String     @id @db.Uuid
  teamId   String     @map("team_id") @db.Uuid
  nom      String
  sens     BudgetSens
  parentId String?    @map("parent_id") @db.Uuid
  couleur  String?
  icone    String?
  ordre    Int        @default(0)
  active   Boolean    @default(true)
  cle      String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team          CoreTeam           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  parent        BudgetCategory?    @relation("CategorieParent", fields: [parentId], references: [id], onDelete: SetNull)
  enfants       BudgetCategory[]   @relation("CategorieParent")
  depenses      BudgetExpense[]
  recettes      BudgetIncome[]
  previsionnels BudgetForecast[]
  suggestions   BudgetSuggestion[]

  @@unique([teamId, sens, nom])
  @@index([teamId])
  @@index([teamId, deletedAt])
  @@map("budget_category")
}

model BudgetPayer {
  id       String           @id @db.Uuid
  teamId   String           @map("team_id") @db.Uuid
  type     BudgetTypePayeur
  personId String?          @map("person_id") @db.Uuid
  nom      String
  actif    Boolean          @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team               CoreTeam              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  person             CorePerson?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  depenses           BudgetExpense[]
  recettesEncaissees BudgetIncome[]
  remboursements     BudgetReimbursement[]
  suggestions        BudgetSuggestion[]

  // Une seule caisse de team : index unique partiel `budget_caisse_unique`, dans la migration (Prisma ne le décrit pas).
  @@unique([teamId, personId])
  @@index([teamId])
  @@index([teamId, deletedAt])
  @@map("budget_payer")
}

model BudgetExpense {
  id                   String              @id @db.Uuid
  teamId               String              @map("team_id") @db.Uuid
  date                 DateTime            @db.Date
  montant              Int
  devise               String              @default("EUR")
  categoryId           String              @map("category_id") @db.Uuid
  libelle              String
  payerId              String              @map("payer_id") @db.Uuid
  moyen                BudgetMoyen?
  fournisseurContactId String?             @map("fournisseur_contact_id") @db.Uuid
  seasonId             String?             @map("season_id") @db.Uuid
  eventId              String?             @map("event_id") @db.Uuid
  entryId              String?             @map("entry_id") @db.Uuid
  vehicleId            String?             @map("vehicle_id") @db.Uuid
  confirmee            Boolean             @default(false)
  aRembourser          Boolean             @default(false) @map("a_rembourser")
  remboursement        BudgetRemboursement @default(non_concerne)
  origine              BudgetOrigine       @default(saisie)
  origineRef           String?             @map("origine_ref")
  justificatifFileId   String?             @map("justificatif_file_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team         CoreTeam                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  category     BudgetCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payer        BudgetPayer               @relation(fields: [payerId], references: [id], onDelete: Restrict)
  fournisseur  CoreContact?              @relation(fields: [fournisseurContactId], references: [id], onDelete: SetNull)
  season       CoreSeason?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event        CoreEvent?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  entry        CoreEventEntry?           @relation(fields: [entryId], references: [id], onDelete: SetNull)
  vehicle      CoreVehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  justificatif CoreFile?                 @relation(fields: [justificatifFileId], references: [id], onDelete: SetNull)
  lignes       BudgetReimbursementLine[]

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([teamId, payerId])
  @@index([teamId, categoryId, seasonId])
  @@map("budget_expense")
}

model BudgetIncome {
  id                  String              @id @db.Uuid
  teamId              String              @map("team_id") @db.Uuid
  date                DateTime            @db.Date
  montant             Int
  devise              String              @default("EUR")
  categoryId          String              @map("category_id") @db.Uuid
  libelle             String
  provenanceContactId String?             @map("provenance_contact_id") @db.Uuid
  provenancePersonId  String?             @map("provenance_person_id") @db.Uuid
  enNature            Boolean             @default(false) @map("en_nature")
  descriptionNature   String?             @map("description_nature")
  valeurEstimee       Int?                @map("valeur_estimee")
  statut              BudgetStatutRecette @default(prevue)
  encaisseeLe         DateTime?           @map("encaissee_le") @db.Date
  encaisseeSurPayerId String?             @map("encaissee_sur_payer_id") @db.Uuid
  seasonId            String?             @map("season_id") @db.Uuid
  eventId             String?             @map("event_id") @db.Uuid
  origine             BudgetOrigine       @default(saisie)
  origineRef          String?             @map("origine_ref")
  justificatifFileId  String?             @map("justificatif_file_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team              CoreTeam       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  category          BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  provenanceContact CoreContact?   @relation(fields: [provenanceContactId], references: [id], onDelete: SetNull)
  provenancePerson  CorePerson?    @relation(fields: [provenancePersonId], references: [id], onDelete: SetNull)
  encaisseeSur      BudgetPayer?   @relation(fields: [encaisseeSurPayerId], references: [id], onDelete: SetNull)
  season            CoreSeason?    @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event             CoreEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  justificatif      CoreFile?      @relation(fields: [justificatifFileId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([teamId, statut])
  @@map("budget_income")
}

model BudgetForecast {
  id          String  @id @db.Uuid
  teamId      String  @map("team_id") @db.Uuid
  seasonId    String  @map("season_id") @db.Uuid
  categoryId  String  @map("category_id") @db.Uuid
  eventId     String? @map("event_id") @db.Uuid
  montant     Int
  devise      String  @default("EUR")
  commentaire String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team     CoreTeam       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  season   CoreSeason     @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  category BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  event    CoreEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([seasonId, categoryId, eventId])
  @@index([teamId])
  @@index([teamId, deletedAt])
  @@map("budget_forecast")
}

model BudgetReimbursement {
  id          String      @id @db.Uuid
  teamId      String      @map("team_id") @db.Uuid
  personId    String      @map("person_id") @db.Uuid
  montant     Int
  devise      String      @default("EUR")
  date        DateTime    @db.Date
