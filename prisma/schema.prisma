// Une pièce physique. Stock propre à chaque voiture (vehicle_id).
model GaragePart {
  id                   String             @id @db.Uuid
  teamId               String             @map("team_id") @db.Uuid
  vehicleId            String             @map("vehicle_id") @db.Uuid
  componentTypeId      String             @map("component_type_id") @db.Uuid
  designation          String
  marque               String?
  reference            String?
  numeroSerie          String?            @map("numero_serie")
  qualite              GarageQualitePiece @default(origine)
  dureeVieKm           Int?               @map("duree_vie_km")
  dureeVieEpreuves     Int?               @map("duree_vie_epreuves")
  acheteeLe            DateTime?          @map("achetee_le") @db.Timestamptz(3)
  prixCents            Int?               @map("prix_cents")
  devise               String             @default("EUR")
  fournisseurContactId String?            @map("fournisseur_contact_id") @db.Uuid
  statut               GarageStatutPiece  @default(en_stock)
  emplacement          String?
  kmCumules            Decimal            @default(0) @map("km_cumules") @db.Decimal(8, 1)
  epreuvesCumulees     Int                @default(0) @map("epreuves_cumulees")
  commandeLigneId      String?            @map("commande_ligne_id") @db.Uuid

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team           CoreTeam            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  vehicle        CoreVehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  componentType  GarageComponentType @relation(fields: [componentTypeId], references: [id], onDelete: Restrict)
  fournisseur    CoreContact?        @relation(fields: [fournisseurContactId], references: [id], onDelete: SetNull)
  commandeLigne  GaragePurchaseLine? @relation("PieceCommandee", fields: [commandeLigneId], references: [id], onDelete: SetNull)
  mounts         GaragePartMount[]
  wearLogs       GarageWearLog[]
  partEtats      GaragePartEtat[]
  workOrderParts GarageWorkOrderPart[]
  incidentParts  GarageIncidentPart[]
  purchaseLines  GaragePurchaseLine[] @relation("PieceAchetee")

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([vehicleId])
  @@index([componentTypeId])
  @@index([fournisseurContactId])
  @@map("garage_part")
}

// Pose et dépose d'une pièce sur un organe. Une seule pose active par organe et par pièce (index partiels, migration).
model GaragePartMount {
  id                 String             @id @db.Uuid
  teamId             String             @map("team_id") @db.Uuid
  partId             String             @map("part_id") @db.Uuid
  vehicleComponentId String             @map("vehicle_component_id") @db.Uuid
  poseLe             DateTime           @map("posee_le") @db.Timestamptz(3)
  kmPose             Decimal            @default(0) @map("km_pose") @db.Decimal(8, 1)
  deposeeLe          DateTime?          @map("deposee_le") @db.Timestamptz(3)
  motifDepose        GarageMotifDepose? @map("motif_depose")

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team             CoreTeam               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  part             GaragePart             @relation(fields: [partId], references: [id], onDelete: Restrict)
  vehicleComponent GarageVehicleComponent @relation(fields: [vehicleComponentId], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([partId])
  @@index([vehicleComponentId])
  @@map("garage_part_mount")
}

// État saisi à la main après une réparation (954 v1.3, §3 et §4). Un journal : une ligne par saisie. L'état courant d'une
// pièce part de sa dernière ligne ; l'usure qui suit le fait baisser. Pourcentage entier, 0 à 100 (CHECK en migration).
model GaragePartEtat {
  id               String   @id @db.Uuid
  teamId           String   @map("team_id") @db.Uuid
  partId           String   @map("part_id") @db.Uuid
  workOrderId      String   @map("work_order_id") @db.Uuid
  etatPct          Int      @map("etat_pct")
  kmAuSaisie       Decimal  @default(0) @map("km_au_saisie") @db.Decimal(8, 1)
  epreuvesAuSaisie Int      @default(0) @map("epreuves_au_saisie")
  saisiLe          DateTime @default(now()) @map("saisi_le") @db.Timestamptz(3)

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team      CoreTeam        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  part      GaragePart      @relation(fields: [partId], references: [id], onDelete: Restrict)
  workOrder GarageWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([partId, saisiLe])
  @@map("garage_part_etat")
}

// Usure ajoutée à une pièce ou à un train de pneus (exactement un des deux : CHECK en migration).
model GarageWearLog {
  id             String            @id @db.Uuid
  teamId         String            @map("team_id") @db.Uuid
  partId         String?           @map("part_id") @db.Uuid
  tyreSetId      String?           @map("tyre_set_id") @db.Uuid
  eventId        String?           @map("event_id") @db.Uuid
  eventEntryId   String?           @map("event_entry_id") @db.Uuid
  kmAjoutes      Decimal           @default(0) @map("km_ajoutes") @db.Decimal(8, 1)
  epreuveComptee Boolean           @default(false) @map("epreuve_comptee")
  date           DateTime          @db.Timestamptz(3)
  source         GarageSourceUsure

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team       CoreTeam        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  part       GaragePart?     @relation(fields: [partId], references: [id], onDelete: Restrict)
  tyreSet    GarageTyreSet?  @relation(fields: [tyreSetId], references: [id], onDelete: Restrict)
  event      CoreEvent?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventEntry CoreEventEntry? @relation(fields: [eventEntryId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([partId])
  @@index([tyreSetId])
  @@index([eventId])
  @@index([eventEntryId])
  @@map("garage_wear_log")
}

// Ordre de travail. Priorité : ajoutée en 4.3 avec ses valeurs (choix 2).
model GarageWorkOrder {
  id                   String             @id @db.Uuid
  teamId               String             @map("team_id") @db.Uuid
  vehicleId            String             @map("vehicle_id") @db.Uuid
  vehicleComponentId   String?            @map("vehicle_component_id") @db.Uuid
  type                 GarageTypeOrdre
  titre                String
  aFaireAvantEventId   String?            @map("a_faire_avant_event_id") @db.Uuid
  dureeEstimeeMinutes  Int?               @map("duree_estimee_minutes")
  statut               GarageStatutOrdre  @default(prevu)
  avancementPct        Int                @default(0) @map("avancement_pct")
  coutMainOeuvreCents  Int?               @map("cout_main_oeuvre_cents")
  devise               String             @default("EUR")
  prestataireContactId String?            @map("prestataire_contact_id") @db.Uuid
  origine              GarageOrigineOrdre @default(saisie)
  priorite             GaragePrioriteTravail @default(normale)

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team             CoreTeam                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  vehicle          CoreVehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleComponent GarageVehicleComponent? @relation(fields: [vehicleComponentId], references: [id], onDelete: SetNull)
  aFaireAvantEvent CoreEvent?              @relation(fields: [aFaireAvantEventId], references: [id], onDelete: SetNull)
  prestataire      CoreContact?            @relation(fields: [prestataireContactId], references: [id], onDelete: SetNull)
  parts            GarageWorkOrderPart[]
  persons          GarageWorkOrderPerson[]
  incidents        GarageIncident[]
  partEtats        GaragePartEtat[]

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([vehicleId])
  @@index([vehicleComponentId])
  @@index([aFaireAvantEventId])
  @@index([prestataireContactId])
  @@map("garage_work_order")
}

// Commande de pièces. La réception crée les pièces en stock (4.3).
model GaragePurchase {
  id                String               @id @db.Uuid
  teamId            String               @map("team_id") @db.Uuid
  vehicleId         String               @map("vehicle_id") @db.Uuid
  supplierContactId String               @map("supplier_contact_id") @db.Uuid
  statut            GarageStatutCommande @default(commandee)
  commandeeLe       DateTime             @map("commandee_le") @db.Timestamptz(3)
  livraisonPrevueLe DateTime?            @map("livraison_prevue_le") @db.Date
  recueLe           DateTime?            @map("recue_le") @db.Timestamptz(3)

  createdAt DateTime  @map("created_at") @db.Timestamptz(3) @default(now())
  updatedAt DateTime  @map("updated_at") @db.Timestamptz(3) @updatedAt
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team     CoreTeam             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  vehicle  CoreVehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
