model SaisonResult {
  id                      String                 @id @db.Uuid
  teamId                  String                 @map("team_id") @db.Uuid
  entryId                 String                 @unique @map("entry_id") @db.Uuid
  statutFinal             SaisonResultStatut     @map("statut_final")
  causeAbandon            String?                @map("cause_abandon")
  stageAbandonId          String?                @map("stage_abandon_id") @db.Uuid
  classementGeneral       Int?                   @map("classement_general")
  nbClasses               Int?                   @map("nb_classes")
  classementGroupe        Int?                   @map("classement_groupe")
  classementClasse        Int?                   @map("classement_classe")
  nbPartantsClasse        Int?                   @map("nb_partants_classe")
  tempsTotalMs            Int?                   @map("temps_total_ms")
  penalitesMs             Int?                   @map("penalites_ms")
