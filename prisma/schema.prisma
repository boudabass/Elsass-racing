  preuveLien              String?                @map("preuve_lien")
  preuveFileId            String?                @map("preuve_file_id") @db.Uuid
  saisiParMembershipId    String?                @map("saisi_par_membership_id") @db.Uuid
  validParMembershipId    String?                @map("valide_par_membership_id") @db.Uuid
  valideLe                DateTime?              @map("valide_le") @db.Timestamptz(3)
  commentaireContestation String?                @map("commentaire_contestation")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team         CoreTeam        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  entry        CoreEventEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  stageAbandon SaisonStage?    @relation(fields: [stageAbandonId], references: [id], onDelete: SetNull)
  preuveFile   CoreFile?       @relation(fields: [preuveFileId], references: [id], onDelete: SetNull)
  saisiPar     CoreMembership? @relation("ResultSaisi", fields: [saisiParMembershipId], references: [id], onDelete: SetNull)
  validePar    CoreMembership? @relation("ResultValide", fields: [validParMembershipId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@map("saison_result")
}

