  payerId              String              @map("payer_id") @db.Uuid
  moyen                BudgetMoyen?
  fournisseurContactId String?             @map("fournisseur_contact_id") @db.Uuid
  seasonId             String?             @map("season_id") @db.Uuid
  eventId              String?             @map("event_id") @db.Uuid
  entryId              String?             @map("entry_id") @db.Uuid
  vehicleId            String?             @map("vehicle_id") @db.Uuid
  confirmee            Boolean             @default(false)
  aRembourser          Boolean             @default(false) @map("a_rembourser")
  remboursement        BudgetRemboursement @default(non_concerne)
  origine              BudgetOrigine       @default(saisie)
  origineRef           String?             @map("origine_ref")
  justificatifFileId   String?             @map("justificatif_file_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team         CoreTeam                  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  category     BudgetCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payer        BudgetPayer               @relation(fields: [payerId], references: [id], onDelete: Restrict)
  fournisseur  CoreContact?              @relation(fields: [fournisseurContactId], references: [id], onDelete: SetNull)
  season       CoreSeason?               @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  event        CoreEvent?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  entry        CoreEventEntry?           @relation(fields: [entryId], references: [id], onDelete: SetNull)
  vehicle      CoreVehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  justificatif CoreFile?                 @relation(fields: [justificatifFileId], references: [id], onDelete: SetNull)
  lignes       BudgetReimbursementLine[]

  @@index([teamId])
  @@index([teamId, deletedAt])
  @@index([teamId, payerId])
  @@index([teamId, categoryId, seasonId])
  @@map("budget_expense")
}

