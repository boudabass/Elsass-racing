  documentGenereFileId       String?                    @map("document_genere_file_id") @db.Uuid
  documentSigneFileId        String?                    @map("document_signe_file_id") @db.Uuid
  signeeLe                   DateTime?                  @map("signee_le") @db.Date
  signataires                String?
  motifResiliation           String?                    @map("motif_resiliation")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  rev       Int       @default(1)

  team            CoreTeam               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  partner         PartenairesPartner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  template        PartenairesTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
