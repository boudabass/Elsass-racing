  precedenteId               String?                    @map("precedente_id") @db.Uuid
  apportFinancierCentimes    Int                        @default(0) @map("apport_financier_centimes")
  devise                     String                     @default("EUR")
  apportNatureDescription    String?                    @map("apport_nature_description")
  apportNatureValeurCentimes Int?                       @map("apport_nature_valeur_centimes")
