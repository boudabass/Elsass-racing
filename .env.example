# Copier ce fichier en `.env.local` et renseigner les valeurs. Ne jamais commiter `.env.local`.

# Connexion de l'application : rôle applicatif, soumis au RLS (lue au runtime).
# Exemple pour la base locale de docker-compose.yml (`pnpm db:up`) :
# DATABASE_URL="postgresql://elsass_racing_app_dev:elsass_racing_app_dev@localhost:5433/elsass_racing"
DATABASE_URL=

# Connexion du propriétaire : migrations, seed, creer-team, CLI Prisma. Jamais dans l'app.
# Exemple local :
# DATABASE_URL_MIGRATION="postgresql://elsass_racing:elsass_racing_dev@localhost:5433/elsass_racing"
DATABASE_URL_MIGRATION=

# Clé de signature des sessions, 32 caractères minimum. L'app refuse de démarrer sans.
SESSION_SECRET=

# Adresse publique de l'app, utilisée dans le lien envoyé par mail.
APP_URL=http://localhost:3000

# SMTP sortant (Odoo). Absent hors production : le mail s'affiche dans la console du serveur.
SMTP_HOST=
# Port du serveur SMTP (587 par défaut ; 465 active TLS direct).
SMTP_PORT=587
# Identifiant SMTP.
SMTP_USER=
# Mot de passe SMTP. Un $ dans une valeur doit être écrit \$ (Next interprète les $ comme des variables).
SMTP_PASSWORD=
# Expéditeur des mails (défaut : Elsass Racing <info@theelsassisch.com>).
MAIL_FROM=

# Sel du hachage des adresses IP dans le journal des liens de partage (Documents, tâche 5.4). Hors production, sans valeur,
# un sel de développement fixe est utilisé et un avertissement s'affiche en console. En production, sans valeur, l'ouverture
# d'un lien est refusée (« Ce lien n'est plus valable ») et l'erreur part dans le journal serveur. Dans Coolify : la valeur brute.
PARTAGE_SEL_IP=
