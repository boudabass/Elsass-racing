# Copier ce fichier en `.env.local` et renseigner les valeurs. Ne jamais commiter `.env.local`.

# Connexion PostgreSQL, lue au runtime (et par la CLI Prisma via prisma.config.ts).
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/elsass_racing

# Clé de signature des sessions, 32 caractères minimum. Pas encore utilisée : requise dès l'authentification.
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-d-au-moins-32-caracteres
