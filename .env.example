# Copier ce fichier en `.env.local` et renseigner les valeurs. Ne jamais commiter `.env.local`.

# Connexion PostgreSQL, lue au runtime et par la CLI Prisma (prisma.config.ts).
# Exemple pour la base locale de docker-compose.yml (`pnpm db:up`) :
# DATABASE_URL="postgresql://elsass_racing:elsass_racing_dev@localhost:5433/elsass_racing"
DATABASE_URL=

# Clé de signature des sessions, 32 caractères minimum. Pas encore utilisée : requise dès l'authentification.
SESSION_SECRET=
