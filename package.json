{
  "name": "elsass-racing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "nettoyer:serveurs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/nettoyer-serveurs.ps1",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "team:creer": "tsx scripts/creer-team.ts",
    "db:verifier-rls": "tsx scripts/verifier-cloisonnement.ts",
    "db:verifier-bus": "tsx scripts/verifier-bus.ts",
    "db:verifier-synchro": "tsx scripts/verifier-synchro.ts",
    "db:verifier-garage": "tsx scripts/verifier-garage.ts",
    "db:initialiser-budget": "tsx scripts/initialiser-budget.ts",
    "donnees:koehling": "tsx scripts/donnees-koehling.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toggle": "^1.1.10",
    "@react-pdf/renderer": "4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "idb": "^8.0.4",
    "jose": "^6.2.12",
    "lucide-react": "^0.511.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8",
    "prisma": "7.10.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4",
    "typescript": "5.8.3",
    "vitest": "^3"
  }
}
